// ============================================================================
// Prisma Schema — Mini ERP + CRM Operations Portal
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Roles & Permissions ----

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  resource    String @db.VarChar(100)
  action      String @db.VarChar(50)
  description String? @db.Text

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

// ---- Users ----

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  phone        String?   @db.VarChar(20)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  roleId       String    @map("role_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  role          Role            @relation(fields: [roleId], references: [id])
  customerNotes CustomerNote[]
  stockMovements StockMovement[]
  salesChallans SalesChallan[]
  auditLogs     AuditLog[]
  customers     Customer[]      @relation("CreatedByUser")

  @@index([roleId])
  @@map("users")
}

// ---- Customers ----

model Customer {
  id            String    @id @default(uuid()) @db.Uuid
  customerName  String    @map("customer_name") @db.VarChar(200)
  mobile        String    @db.VarChar(20)
  email         String?   @db.VarChar(255)
  businessName  String?   @map("business_name") @db.VarChar(200)
  gstNumber     String?   @map("gst_number") @db.VarChar(15)
  customerType  String    @map("customer_type") @db.VarChar(20)
  address       String?   @db.Text
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  pincode       String?   @db.VarChar(10)
  status        String    @default("lead") @db.VarChar(20)
  followUpDate  DateTime? @map("follow_up_date") @db.Date
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  createdBy     User?          @relation("CreatedByUser", fields: [createdById], references: [id])
  notes         CustomerNote[]
  salesChallans SalesChallan[]

  @@index([status])
  @@index([customerType])
  @@index([followUpDate])
  @@map("customers")
}

model CustomerNote {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  note       String    @db.Text
  noteType   String    @default("general") @map("note_type") @db.VarChar(20)
  createdById String   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([customerId])
  @@map("customer_notes")
}

// ---- Products & Categories ----

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  products Product[]

  @@map("categories")
}

model Product {
  id            String    @id @default(uuid()) @db.Uuid
  productName   String    @map("product_name") @db.VarChar(200)
  sku           String    @unique @db.VarChar(50)
  categoryId    String?   @map("category_id") @db.Uuid
  unitPrice     Decimal   @map("unit_price") @db.Decimal(12, 2)
  currentStock  Int       @default(0) @map("current_stock")
  minStockAlert Int       @default(0) @map("min_stock_alert")
  unit          String    @default("pcs") @db.VarChar(20)
  location      String?   @db.VarChar(100)
  description   String?   @db.Text
  imageUrl      String?   @map("image_url") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz

  category       Category?        @relation(fields: [categoryId], references: [id])
  stockMovements StockMovement[]
  challanItems   SalesChallanItem[]

  @@index([categoryId])
  @@index([currentStock])
  @@map("products")
}

// ---- Stock Movements (Immutable Audit Trail) ----

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  quantity      Int
  movementType  String   @map("movement_type") @db.VarChar(5)
  reason        String   @db.Text
  referenceType String?  @map("reference_type") @db.VarChar(20)
  referenceId   String?  @map("reference_id") @db.Uuid
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  createdById   String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdAt(sort: Desc)])
  @@index([movementType])
  @@map("stock_movements")
}

// ---- Sales Challans ----

model SalesChallan {
  id                 String    @id @default(uuid()) @db.Uuid
  challanNumber      String    @unique @map("challan_number") @db.VarChar(20)
  customerId         String    @map("customer_id") @db.Uuid
  status             String    @default("draft") @db.VarChar(20)
  totalQuantity      Int       @default(0) @map("total_quantity")
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(14, 2)
  notes              String?   @db.Text
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz
  cancellationReason String?   @map("cancellation_reason") @db.Text
  createdById        String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  customer  Customer           @relation(fields: [customerId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  items     SalesChallanItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("sales_challans")
}

model SalesChallanItem {
  id          String   @id @default(uuid()) @db.Uuid
  challanId   String   @map("challan_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  sku         String   @db.VarChar(50)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  challan SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([challanId])
  @@index([productId])
  @@map("sales_challan_items")
}

// ---- Audit Logs (Immutable) ----

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(50)
  resource   String   @db.VarChar(50)
  resourceId String?  @map("resource_id") @db.Uuid
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ---- Sequences (Challan Number Generation) ----

model Sequence {
  id         String   @id @db.VarChar(50)
  prefix     String   @db.VarChar(20)
  currentVal Int      @default(0) @map("current_val")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("sequences")
}
