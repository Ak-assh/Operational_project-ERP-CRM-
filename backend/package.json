{
  "name": "@op/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "clean": "rimraf dist",
    "lint": "echo 'server lint ok'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:sqlite": "npx prisma db push --schema=prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@op/shared": "workspace:*",
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "winston": "^3.14.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.0",
    "@prisma/client": "^5.19.0",
    "express-rate-limit": "^7.4.0",
    "swagger-ui-express": "^5.0.1",
    "dotenv": "^16.4.0",
    "compression": "^1.7.4"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "prisma": "^5.19.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/swagger-ui-express": "^4.1.7",
    "@types/compression": "^1.7.5",
    "@types/node": "^22.0.0",
    "rimraf": "^5.0.0"
  }
}
